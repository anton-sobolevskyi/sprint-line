FROM node:24-alpine

WORKDIR /app

# Install dependencies first (better caching)
COPY package*.json ./
RUN npm install

# Copy the rest of the source
COPY . .

EXPOSE 4200

# --host 0.0.0.0 is required so the server is reachable from outside the container
CMD ["npm", "start", "--", "--host", "0.0.0.0", "--poll", "2000"]

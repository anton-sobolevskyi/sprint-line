# Pin the Node patch version to one supported by your Angular version.
FROM node:22-bookworm AS base
WORKDIR /app

# Install the Playwright package and Chromium system/browser dependencies.
RUN npx playwright install --with-deps

FROM base AS deps
COPY package.json package-lock.json .npmrc ./
RUN npm ci

FROM deps AS dev
COPY . .
CMD ["npm", "run", "start:docker"]

FROM deps AS unit
COPY . .
CMD ["npm", "run", "test:ci"]

FROM deps AS e2e
COPY . .
CMD ["npm", "run", "e2e"]

